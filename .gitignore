# ==============================================================================
# .gitignore for Android Malware Classification (IE105)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE / Editor settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# CRITICAL: Files exceeding GitHub 100 MB Limit
# GitHub rejects pushes containing files larger than 100 MB
# ------------------------------------------------------------------------------
dataset/CSV/50000_extracted features.csv
*.zip
*.tar.gz
*.7z

# Temporary / prediction outputs
predictions_*.csv
temp/
scratch/
